# Backend configuration. Copy to .env.development and fill in.
# Every value here has a working default — the backend boots with none of them
# set, but the chain and MQTT layers stay disabled until they are.

PORT=5001
NODE_ENV=development

JWT_SECRET=change-in-production
JWT_REFRESH_SECRET=change-in-production
GOOGLE_CLIENT_ID=

# ── Blockchain ──────────────────────────────────────────────────────────────
# With CHAIN_RPC_URL empty the backend runs chain-less: signatures are checked
# against the public key stored locally at enrolment, and the on-chain policy
# and revocation gates are skipped. Fine for development, not for a defence.
#
# Local:   npx hardhat node   (in blockchain/) then deploy.js --network localhost
# Sepolia: an Infura/Alchemy URL, and a funded deployer key.
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_NETWORK=localhost

# Must hold BACKEND_ROLE on DIDRegistry and AuditLog. Reads work without it;
# registerDID and logEvent do not. Below is hardhat account #0 — a publicly
# known key. NEVER use it on a network where the funds or the roles matter.
CHAIN_BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Addresses are read from blockchain/deployments/<CHAIN_NETWORK>.json by
# default. Set these to point at a deployment made elsewhere.
# CHAIN_DEPLOYMENT_FILE=../blockchain/deployments/sepolia.json
# CONTRACT_DID_REGISTRY=
# CONTRACT_ACCESS_POLICY=
# CONTRACT_AUDIT_LOG=

# true = the chain is authoritative and an unreachable chain denies access.
# This is the correct production posture; leave it false only while developing
# without a node. Every access_event records `chain_checked`, so a row that got
# in without the chain says so.
CHAIN_REQUIRED=false

# ── MQTT (the physical door) ────────────────────────────────────────────────
# Empty = unlock commands are logged, not published. Each door row carries its
# own topic; see specs/HARDWARE_ACCESS_NOTES.md for the smart-plug setup.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=access-backend
MQTT_HOLD_SECONDS=5

# ── Access policy ───────────────────────────────────────────────────────────
# How stale a signed request may be, in seconds, and the allowed clock skew.
ACCESS_MAX_REQUEST_AGE=90
ACCESS_MAX_CLOCK_SKEW=30

# The backend re-checks the on-device face score rather than trusting the app's
# own gate. Set false only for hardware-free testing — it disables the
# biometric factor entirely. 0.7 matches the app's SIMILARITY_THRESHOLD.
ACCESS_REQUIRE_FACE=true
ACCESS_FACE_THRESHOLD=0.7
