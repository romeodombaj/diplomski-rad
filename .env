# Host ports for `docker compose up`. Compose reads this file automatically, so
# plain `docker compose up -d` is enough — no inline VAR= prefixes.
#
# BACKEND_PORT is the one that is NOT free to change. The phone's API base is
# inlined into its JS bundle at build time (EXPO_PUBLIC_API_URL in
# mobile-app/.env), so moving the backend to another port means rebuilding and
# reinstalling the app. Keep these two in agreement.
BACKEND_PORT=5001
FRONTEND_PORT=8085
MQTT_PORT=1883

# LED steps per door ring. MUST match LED_LEVELS in the *installed* app build.
# 12 = one step per physical LED, matching the app now installed.
PROXIMITY_LEVELS=12

# Host port for the behaviour engine. 8000 is taken by a Windows process and
# WSL mirrored networking shares that port space. Only used for poking the
# engine directly — the backend reaches it over the Docker network as
# http://behavior:8000 regardless.
BEHAVIOR_PORT=8010

# LAN the door hardware lives on, swept during a device scan for Tuya plugs
# (port 6668). Must be a /24. Empty disables the sweep.
DEVICE_SCAN_SUBNET=192.168.88.0/24
